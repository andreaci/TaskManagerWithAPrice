<Window x:Class="TaskCost.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TaskCost" Width="1280" Height="800" MinWidth="900" MinHeight="600"
        Background="#F5F5F5" FontFamily="Segoe UI" FontSize="13" WindowStartupLocation="CenterScreen">
  <Window.Resources>
    <Style x:Key="NavButton" TargetType="Button">
      <Setter Property="Width" Value="48"/><Setter Property="Height" Value="48"/><Setter Property="Margin" Value="0,3"/>
      <Setter Property="FontFamily" Value="Segoe Fluent Icons"/><Setter Property="FontSize" Value="18"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderBrush" Value="Transparent"/>
    </Style>
    <Style x:Key="MetricCell" TargetType="TextBlock">
      <Setter Property="HorizontalAlignment" Value="Right"/><Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style x:Key="Input" TargetType="TextBox">
      <Setter Property="Height" Value="34"/><Setter Property="Padding" Value="9,5"/><Setter Property="BorderBrush" Value="#BEBEBE"/>
    </Style>
  </Window.Resources>

  <Grid>
    <Grid.RowDefinitions><RowDefinition Height="48"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <Border Grid.Row="0" Background="#F5F5F5" BorderBrush="#DDDDDD" BorderThickness="0,0,0,1">
      <Grid Margin="13,0,18,0">
        <Grid.ColumnDefinitions><ColumnDefinition Width="260"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <Border Width="24" Height="24" CornerRadius="5" Background="#D7F1FB" Margin="0,0,10,0"><TextBlock Text="▥" Foreground="#087EA4" FontSize="17" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
          <TextBlock Text="TaskCost" FontWeight="SemiBold" VerticalAlignment="Center"/>
        </StackPanel>
        <Border Grid.Column="1" MaxWidth="520" Height="34" Background="White" BorderBrush="#DDDDDD" BorderThickness="1" CornerRadius="6" HorizontalAlignment="Center">
          <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="38"/><ColumnDefinition/></Grid.ColumnDefinitions><TextBlock Text="⌕" FontSize="20" Foreground="#777" HorizontalAlignment="Center" VerticalAlignment="Center"/><TextBox x:Name="SearchBox" Grid.Column="1" BorderThickness="0" Background="Transparent" VerticalContentAlignment="Center" FontSize="14" TextChanged="SearchBox_TextChanged" ToolTip="Filter by name, description, path, or PID"/></Grid>
        </Border>
        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
          <TextBlock x:Name="HeaderPrice" Foreground="#666" VerticalAlignment="Center" Margin="0,0,12,0"/>
          <Button x:Name="RefreshButton" Click="RefreshButton_Click" ToolTip="Refresh process list now" Padding="10,6">
            <StackPanel Orientation="Horizontal">
              <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE72C;" FontSize="14" Margin="0,0,7,0" VerticalAlignment="Center"/>
              <TextBlock Text="Refresh" VerticalAlignment="Center"/>
            </StackPanel>
          </Button>
        </StackPanel>
      </Grid>
    </Border>

    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions><ColumnDefinition Width="64"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <Border Background="#F5F5F5" BorderBrush="#E0E0E0" BorderThickness="0,0,1,0">
        <DockPanel>
          <Button DockPanel.Dock="Bottom" Style="{StaticResource NavButton}" Content="" ToolTip="Settings" Click="Settings_Click" Margin="0,3,0,10"/>
          <StackPanel>
            <Button Style="{StaticResource NavButton}" Content="" ToolTip="Processes" Click="Processes_Click"/>
            <Button Style="{StaticResource NavButton}" Content="" ToolTip="Details" Click="Details_Click"/>
          </StackPanel>
        </DockPanel>
      </Border>

      <Border Grid.Column="1" Background="White" CornerRadius="9,0,0,0" BorderBrush="#E1E1E1" BorderThickness="1,1,0,0">
        <Grid>
          <Grid x:Name="ProcessesView">
            <Grid.RowDefinitions><RowDefinition Height="50"/><RowDefinition Height="48"/><RowDefinition Height="*"/><RowDefinition Height="30"/></Grid.RowDefinitions>
            <TextBlock Text="Processes" FontSize="17" FontWeight="SemiBold" Margin="17,0" VerticalAlignment="Center"/>
            <Grid Grid.Row="1" Background="#FBFBFB" Margin="0,0,0,1">
              <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="90"/><ColumnDefinition Width="110"/><ColumnDefinition Width="115"/><ColumnDefinition Width="110"/></Grid.ColumnDefinitions>
              <TextBlock Text="Live process groups" Foreground="#666" Margin="16,0" VerticalAlignment="Center"/>
              <StackPanel Grid.Column="1" HorizontalAlignment="Center"><TextBlock x:Name="CpuSummary" FontSize="17" HorizontalAlignment="Center"/><TextBlock Text="CPU" Foreground="#666"/></StackPanel>
              <StackPanel Grid.Column="2" HorizontalAlignment="Center"><TextBlock x:Name="MemorySummary" FontSize="17" HorizontalAlignment="Center"/><TextBlock Text="Memory" Foreground="#666"/></StackPanel>
              <StackPanel Grid.Column="3" HorizontalAlignment="Center"><TextBlock x:Name="CostSummary" FontSize="17" HorizontalAlignment="Center"/><TextBlock Text="Memory value" Foreground="#666"/></StackPanel>
              <StackPanel Grid.Column="4" HorizontalAlignment="Center"><TextBlock x:Name="ProcessSummary" FontSize="17" HorizontalAlignment="Center"/><TextBlock Text="Processes" Foreground="#666"/></StackPanel>
            </Grid>
            <DataGrid x:Name="ProcessesGrid" Grid.Row="2" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" CanUserSortColumns="True" GridLinesVisibility="Vertical" HeadersVisibility="Column" BorderThickness="0" RowHeaderWidth="0" SelectionMode="Single" EnableRowVirtualization="True" EnableColumnVirtualization="True" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" ScrollViewer.IsDeferredScrollingEnabled="True">
              <DataGrid.Columns>
                <DataGridTextColumn Header="Name" Binding="{Binding NameWithCount}" SortMemberPath="DisplayName" Width="*" MinWidth="230"/>
                <DataGridTextColumn Header="Status" Binding="{Binding Status}" SortMemberPath="Status" Width="90"/>
                <DataGridTextColumn Header="CPU" Binding="{Binding CpuText}" SortMemberPath="CpuPercent" Width="90" ElementStyle="{StaticResource MetricCell}"/>
                <DataGridTextColumn Header="Memory" Binding="{Binding MemoryText}" SortMemberPath="WorkingSetBytes" Width="110" ElementStyle="{StaticResource MetricCell}"/>
                <DataGridTextColumn Header="Memory value" Binding="{Binding CostText}" SortMemberPath="Cost" Width="115" ElementStyle="{StaticResource MetricCell}"/>
                <DataGridTextColumn Header="Threads" Binding="{Binding ThreadCount}" SortMemberPath="ThreadCount" Width="85" ElementStyle="{StaticResource MetricCell}"/>
                <DataGridTextColumn Header="Handles" Binding="{Binding HandleCount}" SortMemberPath="HandleCount" Width="85" ElementStyle="{StaticResource MetricCell}"/>
                <DataGridTextColumn Header="Private memory" Binding="{Binding PrivateText}" SortMemberPath="PrivateBytes" Width="115" ElementStyle="{StaticResource MetricCell}"/>
                <DataGridTextColumn Header="Description" Binding="{Binding Description}" SortMemberPath="Description" Width="220"/>
              </DataGrid.Columns>
            </DataGrid>
            <TextBlock x:Name="ProcessesStatus" Grid.Row="3" Foreground="#666" Margin="12,0" VerticalAlignment="Center"/>
          </Grid>

          <Grid x:Name="DetailsView" Visibility="Collapsed">
            <Grid.RowDefinitions><RowDefinition Height="50"/><RowDefinition Height="*"/><RowDefinition Height="30"/></Grid.RowDefinitions>
            <TextBlock Text="Details" FontSize="17" FontWeight="SemiBold" Margin="17,0" VerticalAlignment="Center"/>
            <DataGrid x:Name="DetailsGrid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" CanUserSortColumns="True" GridLinesVisibility="Vertical" HeadersVisibility="Column" BorderThickness="0" RowHeaderWidth="0" SelectionMode="Single" EnableRowVirtualization="True" EnableColumnVirtualization="True" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" ScrollViewer.IsDeferredScrollingEnabled="True">
              <DataGrid.Columns>
                <DataGridTextColumn Header="Name" Binding="{Binding Name}" SortMemberPath="Name" Width="170"/>
                <DataGridTextColumn Header="PID" Binding="{Binding Id}" SortMemberPath="Id" Width="75"/>
                <DataGridTextColumn Header="Status" Binding="{Binding Status}" SortMemberPath="Status" Width="80"/>
                <DataGridTextColumn Header="CPU" Binding="{Binding CpuText}" SortMemberPath="CpuPercent" Width="75" ElementStyle="{StaticResource MetricCell}"/>
                <DataGridTextColumn Header="Memory" Binding="{Binding MemoryText}" SortMemberPath="WorkingSetBytes" Width="105" ElementStyle="{StaticResource MetricCell}"/>
                <DataGridTextColumn Header="Memory value" Binding="{Binding CostText}" SortMemberPath="Cost" Width="115" ElementStyle="{StaticResource MetricCell}"/>
                <DataGridTextColumn Header="Private memory" Binding="{Binding PrivateText}" SortMemberPath="PrivateBytes" Width="115" ElementStyle="{StaticResource MetricCell}"/>
                <DataGridTextColumn Header="Virtual memory" Binding="{Binding VirtualText}" SortMemberPath="VirtualBytes" Width="115" ElementStyle="{StaticResource MetricCell}"/>
                <DataGridTextColumn Header="Threads" Binding="{Binding ThreadCount}" SortMemberPath="ThreadCount" Width="75" ElementStyle="{StaticResource MetricCell}"/>
                <DataGridTextColumn Header="Handles" Binding="{Binding HandleCount}" SortMemberPath="HandleCount" Width="80" ElementStyle="{StaticResource MetricCell}"/>
                <DataGridTextColumn Header="Architecture" Binding="{Binding Architecture}" SortMemberPath="Architecture" Width="95"/>
                <DataGridTextColumn Header="Priority" Binding="{Binding Priority}" SortMemberPath="Priority" Width="95"/>
                <DataGridTextColumn Header="CPU time" Binding="{Binding CpuTimeText}" SortMemberPath="CpuTime" Width="95"/>
                <DataGridTextColumn Header="Started" Binding="{Binding StartedText}" SortMemberPath="Started" Width="135"/>
                <DataGridTextColumn Header="Description" Binding="{Binding Description}" SortMemberPath="Description" Width="230"/>
                <DataGridTextColumn Header="Path" Binding="{Binding FilePath}" SortMemberPath="FilePath" Width="350"/>
              </DataGrid.Columns>
            </DataGrid>
            <TextBlock x:Name="DetailsStatus" Grid.Row="2" Foreground="#666" Margin="12,0" VerticalAlignment="Center"/>
          </Grid>

          <ScrollViewer x:Name="SettingsView" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="28" MaxWidth="700" HorizontalAlignment="Left">
              <TextBlock Text="Settings" FontSize="22" FontWeight="SemiBold"/>
              <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                <Button x:Name="DownloadMarketDataButton" Content="Download latest and clear custom" Click="DownloadMarketData_Click"/>
                <TextBlock x:Name="MarketDataStatus" Margin="12,0,0,0" Foreground="#555" VerticalAlignment="Center"/>
              </StackPanel>
              <TextBlock Text="Memory pricing" FontSize="17" FontWeight="SemiBold" Margin="0,28,0,6"/>
              <TextBlock Text="Downloaded values are cached daily. Editing DDR4 or DDR5 marks RAM pricing as custom and stops automatic RAMTrack updates until custom values are cleared." Foreground="#555" TextWrapping="Wrap" Margin="0,0,0,18"/>
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="130"/><ColumnDefinition Width="170"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Grid.RowDefinitions><RowDefinition Height="44"/><RowDefinition Height="44"/><RowDefinition Height="44"/></Grid.RowDefinitions>
                <TextBlock Text="DDR3 / GB" VerticalAlignment="Center"/><TextBox x:Name="Ddr3Box" Grid.Column="1" Style="{StaticResource Input}"/>
                <TextBlock Grid.Row="1" Text="DDR4 / GB" VerticalAlignment="Center"/><TextBox x:Name="Ddr4Box" Grid.Row="1" Grid.Column="1" Style="{StaticResource Input}"/>
                <TextBlock Grid.Row="2" Text="DDR5 / GB" VerticalAlignment="Center"/><TextBox x:Name="Ddr5Box" Grid.Row="2" Grid.Column="1" Style="{StaticResource Input}"/>
                <TextBlock Grid.Column="2" Grid.RowSpan="3" Margin="18,5" Foreground="#666" TextWrapping="Wrap" Text="RAMTrack publishes Dutch retail averages for DDR4 and DDR5. DDR3 is custom-only. The online refresh uses RAMTrack's current, undocumented read-only price endpoint."/>
              </Grid>
              <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                <Button Content="Open ramtrack.eu" Click="OpenRamTrack_Click"/>
                <TextBlock x:Name="RamTrackStatus" Margin="12,0,0,0" Foreground="#555" VerticalAlignment="Center"/>
              </StackPanel>

              <TextBlock Text="Calculation &amp; currency" FontSize="17" FontWeight="SemiBold" Margin="0,30,0,12"/>
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="170"/><ColumnDefinition Width="190"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Grid.RowDefinitions><RowDefinition Height="48"/><RowDefinition Height="48"/><RowDefinition Height="48"/></Grid.RowDefinitions>
                <TextBlock Text="Installed RAM type" VerticalAlignment="Center"/><ComboBox x:Name="RamTypeBox" Grid.Column="1" Height="34" VerticalContentAlignment="Center" SelectionChanged="SettingsSelectionChanged"/>
                <TextBlock Grid.Row="1" Text="Display currency" VerticalAlignment="Center"/><ComboBox x:Name="CurrencyBox" Grid.Row="1" Grid.Column="1" Height="34" VerticalContentAlignment="Center" SelectionChanged="CurrencyBox_SelectionChanged"/>
                <TextBlock x:Name="ExchangeRateStatus" Grid.Row="1" Grid.Column="2" Margin="12,0,0,0" Foreground="#666" VerticalAlignment="Center"/>
                <TextBlock Grid.Row="2" Text="EUR conversion rate" VerticalAlignment="Center"/><TextBox x:Name="RateBox" Grid.Row="2" Grid.Column="1" Style="{StaticResource Input}"/>
                <TextBlock Grid.Row="2" Grid.Column="2" Margin="12,0" VerticalAlignment="Center" Foreground="#666" Text="1 EUR equals this amount; editable for your preferred rate."/>
              </Grid>
              <Border Background="#F3F8FC" BorderBrush="#CCE5F5" BorderThickness="1" CornerRadius="6" Padding="14" Margin="0,16">
                <TextBlock x:Name="FormulaPreview" TextWrapping="Wrap"/>
              </Border>
              <StackPanel Orientation="Horizontal">
                <Button Content="Save settings" Background="#0F6CBD" Foreground="White" BorderBrush="#0F6CBD" Click="ApplySettings_Click"/>
                <TextBlock x:Name="SaveStatus" Margin="12,0,0,0" Foreground="#287A32" VerticalAlignment="Center"/>
              </StackPanel>
            </StackPanel>
          </ScrollViewer>
        </Grid>
      </Border>
    </Grid>
  </Grid>
</Window>
